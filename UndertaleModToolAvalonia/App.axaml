<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UndertaleModToolAvalonia.App"
             Name="UndertaleModToolAvalonia"
             RequestedThemeVariant="Default">
    <!-- Custom color scheme: replaces the pure black/white Fluent defaults with
         a warm "paper" light theme and a blue-tinted "midnight" dark theme. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Backgrounds -->
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#F2FAF4" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush" Color="#E7F5EA" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush" Color="#E0F0E4" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush" Color="#D9ECDE" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltLowBrush" Color="#D3E8D8" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#DDEEE1" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="#D6E9DA" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumHighBrush" Color="#CDE3D2" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseHighBrush" Color="#B8D3BE" />
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#E4F2E7" />
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#DCEEE1" />
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeHighBrush" Color="#D1E6D6" />
                    <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="#E8F5EB" />
                    <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="#DDEEE1" />
                    <SolidColorBrush x:Key="SystemControlBackgroundListMediumHighBrush" Color="#D1E6D6" />
                    <!-- Foregrounds -->
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#16351F" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#4F7059" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#78937F" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#9BB5A1" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltHighBrush" Color="#F2FAF4" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltMediumHighBrush" Color="#E7F5EA" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltMediumBrush" Color="#E4E0D5" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltLowBrush" Color="#D8D3C4" />
                    <!-- Highlights / hover / selection -->
                    <SolidColorBrush x:Key="SystemControlHighlightBaseLowBrush" Color="#9FC8AA" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseMediumBrush" Color="#86B995" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseMediumHighBrush" Color="#6FA47E" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseHighBrush" Color="#5A8E69" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseLowBrush" Color="#9FC8AA" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseMediumBrush" Color="#86B995" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseMediumHighBrush" Color="#6FA47E" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="#5A8E69" />
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#D1E6D6" />
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#B8DEC2" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#D2EBDD" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#B8DEC2" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#98CFA6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- Backgrounds -->
                    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#1D2B22" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumHighBrush" Color="#24352A" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush" Color="#213027" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumLowBrush" Color="#1F2D24" />
                    <SolidColorBrush x:Key="SystemControlBackgroundAltLowBrush" Color="#1B281F" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#18241C" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="#1B281F" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumHighBrush" Color="#24352A" />
                    <SolidColorBrush x:Key="SystemControlBackgroundBaseHighBrush" Color="#314536" />
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#252937" />
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#1E222E" />
                    <SolidColorBrush x:Key="SystemControlBackgroundChromeHighBrush" Color="#24352A" />
                    <SolidColorBrush x:Key="SystemControlBackgroundListLowBrush" Color="#18241C" />
                    <SolidColorBrush x:Key="SystemControlBackgroundListMediumBrush" Color="#273A2D" />
                    <SolidColorBrush x:Key="SystemControlBackgroundListMediumHighBrush" Color="#2D4233" />
                    <!-- Foregrounds -->
                    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#E7F2E9" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#A7B9AC" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#7E9785" />
                    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#5D7564" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltHighBrush" Color="#111A14" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltMediumHighBrush" Color="#162319" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltMediumBrush" Color="#1B2A20" />
                    <SolidColorBrush x:Key="SystemControlForegroundAltLowBrush" Color="#22352A" />
                    <!-- Highlights / hover / selection -->
                    <SolidColorBrush x:Key="SystemControlHighlightBaseLowBrush" Color="#476451" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseMediumBrush" Color="#5D7864" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseMediumHighBrush" Color="#71907A" />
                    <SolidColorBrush x:Key="SystemControlHighlightBaseHighBrush" Color="#86A48E" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseLowBrush" Color="#476451" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseMediumBrush" Color="#5D7864" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseMediumHighBrush" Color="#71907A" />
                    <SolidColorBrush x:Key="SystemControlHighlightAltBaseHighBrush" Color="#86A48E" />
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#263C2D" />
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#365C42" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#2E5139" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#365C42" />
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#3E704D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="/Styles.axaml" />
    </Application.Styles>

    <NativeMenu.Menu>
        <NativeMenu></NativeMenu>
    </NativeMenu.Menu>
</Application>
